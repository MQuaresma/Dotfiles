{
  "workbench.startupEditor": "none",
  "workbench.editor.showIcons": false,
  "workbench.layoutControl.enabled": false,
  "workbench.navigationControl.enabled": false,
  "editor.cursorStyle": "block",
  "editor.minimap.enabled": false,
  "editor.scrollBeyondLastLine": false,
  "editor.scrollBeyondLastColumn": 0,
  "editor.detectIndentation": false,
  "editor.fontLigatures": false,
  "editor.tabSize": 2,
  "editor.accessibilitySupport": "off",
  "editor.wordWrap": "on",
  "terminal.integrated.shellIntegration.enabled": false,
  "search.showLineNumbers": true,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "update.showReleaseNotes": false,
  "extensions.ignoreRecommendations": true,
  "debug.toolBarLocation": "floating",
  "workbench.editor.empty.hint": "hidden",
  "telemetry.telemetryLevel": "off",
  "chat.commandCenter.enabled": false,
  "latex-workshop.latex.autoBuild.run": "never",
  "remote.SSH.enableX11Forwarding": false,
  "remote.SSH.configFile": "~/.ssh/config",
  "lean4.alwaysAskBeforeInstallingLeanVersions": true,
  "go.toolsManagement.autoUpdate": true,
  "chat.disableAIFeatures": true,
  "git.openRepositoryInParentFolders": "never",
  "rust-analyzer.cargo.extraEnv": {
    "LIBCLANG_PATH": "/Library/Developer/CommandLineTools/usr/lib",
    "DYLD_FALLBACK_LIBRARY_PATH": "/Library/Developer/CommandLineTools/usr/lib"
  },
  "swift.searchSubfoldersForPackages": true,
  "swift.ignoreSearchingForPackagesInSubfolders": [
    ".",
    ".build",
    "Packages",
    "out",
    "bazel-out",
    "bazel-bin",
    ".git"
  ],
  "claudeCode.preferredLocation": "sidebar",
  "files.associations": {
    "*.jazz": "c",
    "*.jahh": "c",
    "*.jinc": "c",
    "*.sage": "python"
  },
  "files.enableTrash": false,
  "files.exclude": {
      "**/.git": true,
      "**/.svn": true,
      "**/.hg": true,
      "**/CVS": true,
      "**/.DS_Store": true,
      "**/*.class": true,
      "**/._*": true,
      "**/*.out": true,
      ".gradle/**": true,
  },
  "ltex.checkFrequency": "manual",
  "claudeCode.hideOnboarding": true,
  "workbench.sideBar.location": "right",
  // "ocaml.repl.useUtop": false
  }